  "components": {
    "schemas": {
      "Roads": {
        "type": "object",
        "properties": {
          "roads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoadId"
            }
          }
        }
      },
      "RoadId": {
        "type": "string",
        "pattern": "[A-Z][A-Za-z]*[1-9]([0-9]{1,3})?(\\/[A-Z][A-Za-z]*[1-9]([0-9]{1,3})?)?",
        "description": "Can be any valid road identifier (not limited to highways). Validity is not checked: queries with non-existent road identifiers will return an empty dataset. The notation may differ from the standard form (e.g. S1234 instead of St1234 for state roads).\n",
        "example": "A1"
      },
      "Extent": {
        "type": "string",
        "pattern": "-?\\d+(?:\\.\\d+)?,\\s*-?\\d+(?:\\.\\d+)?,\\s*-?\\d+(?:\\.\\d+)?,\\s*-?\\d+(?:\\.\\d+)?",
        "description": "Rectangle (in WGS84 coordinates) enclosing the affected road section.",
        "example": "10.728384054665147,54.00605746113356,10.775848767524598,54.09436740278899"
      },
      "Point": {
        "type": "string",
        "pattern": "-?\\d+(?:\\.\\d+)?,\\s*-?\\d+(?:\\.\\d+)?",
        "description": "Start of the affected road section (longitude and latitude in WGS84). Identical to Coordinate, but rounding-related deviations are possible.",
        "example": "10.729057,54.006057"
      },
      "Coordinate": {
        "type": "object",
        "description": "Start of the affected road section (coordinates in WGS84). Identical to Point, but rounding-related deviations are possible.",
        "example": {
          "lat": "54.006057",
          "long": "10.729057"
        },
        "properties": {
          "lat": {
            "$ref": "#/components/schemas/LatLongValue"
          },
          "long": {
            "$ref": "#/components/schemas/LatLongValue"
          }
        }
      },
      "LatLongValue": {
        "type": "string",
        "pattern": "-?\\d+(?:\\.\\d+)?"
      },
      "Identifier": {
        "type": "string",
        "format": "byte"
      },
      "MultilineText": {
        "type": "array",
        "example": [
          "Start: 29.06.2021 09:00",
          "End: 28.11.2021 17:00",
          "",
          "Type of measure: Asphalt resurfacing",
          "Restrictions: Only 1 lane available.\n\nFull closure of exit Eutin east side from 17.07.2021 - 15.09.2021.\n\nFull closure of exit Scharbeutz east side from 16.09.2021 - 17.11.2021.",
          "Maximum passage width: 3.25\n"
        ],
        "items": {
          "type": "string"
        }
      },
      "IconRef": {
        "type": "string",
        "description": "Icon describing the type of the entry. Most are taken from the official road sign catalog, but some have different meanings and/or unofficial sub-numbers. Where no appropriate road sign exists, non-numeric values are used:\n<ul>\n<li>101: Danger</li>\n<li>123: Construction</li>\n<li>250: Closure</li>\n<li>262-2: Max. 3.5t</li>\n<li>314-50: Rest Area (Cars/Trucks)</li>\n<li>314-50-2: Rest Area (Cars Only)</li>\n<li>448: Exit Closed</li>\n<li>charging_plug_strong: Fast Charging Station for Electric Vehicles</li>\n<li>warnkegel: Short-term Construction Zone</li>\n</ul>\n"
      },
      "DisplayType": {
        "type": "string",
        "enum": [
          "ROADWORKS",
          "WEBCAM",
          "PARKING",
          "WARNING",
          "WEIGHT_LIMIT_35",
          "CLOSURE",
          "CLOSURE_ENTRY_EXIT",
          "STRONG_ELECTRIC_CHARGING_STATION",
          "SHORT_TERM_ROADWORKS",
          "ELECTRIC_CHARGING_STATION"
        ]
      },
      "LorryParkingFeatureIcon": {
        "type": "object",
        "example": {
          "icon": "almofont almo-picnic_facility",
          "description": "Picnic facilities",
          "style": ""
        },
        "properties": {
          "icon": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "style": {
            "type": "string"
          }
        }
      },
      "RoadItem": {
        "type": "object",
        "properties": {
          "extent": {
            "$ref": "#/components/schemas/Extent"
          },
          "identifier": {
            "$ref": "#/components/schemas/Identifier"
          },
          "routeRecommendation": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "footer": {
            "$ref": "#/components/schemas/MultilineText"
          },
          "icon": {
            "$ref": "#/components/schemas/IconRef"
          },
          "isBlocked": {
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/MultilineText"
          },
          "title": {
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "display_type": {
            "$ref": "#/components/schemas/DisplayType"
          },
          "lorryParkingFeatureIcons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LorryParkingFeatureIcon"
            }
          },
          "future": {
            "type": "boolean"
          },
          "subtitle": {
            "type": "string"
          }
        }
      },
      "RoadEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RoadItem"
          },
          {
            "type": "object",
            "properties": {
              "startTimestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "Roadworks": {
        "type": "object",
        "properties": {
          "roadworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Roadwork"
            }
          }
        }
      },
      "Roadwork": {
        "example": {
          "extent": "10.728384054665147,54.00605746113356,10.775848767524598,54.09436740278899",
          "identifier": "Uk9BRFdPUktTX19tZG0uc2hfXzYzMTU=",
