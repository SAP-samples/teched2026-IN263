{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.1",
    "title": "Autobahn App API",
    "contact": {
      "url": "https://www.autobahn.de/datenschutz/",
      "email": "kontakt@autobahn.de",
      "name": "Die Autobahn GmbH des Bundes"
    },
    "x-office": "Federal Ministry for Digital and Transport",
    "description": "What's happening on Germany's federal highways? API for current administrative data on road construction, traffic jams, and charging stations. Also provides access to traffic monitoring cameras and many additional datasets.\n"
  },
  "servers": [
    {
      "url": "https://verkehr.autobahn.de/o/autobahn"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "list-autobahnen",
        "summary": "List Available Highways",
        "description": "Returns a list of available highways.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Roads"
                }
              }
            }
          }
        }
      }
    },
    "/{roadId}/services/roadworks": {
      "get": {
        "operationId": "list-roadworks",
        "summary": "List Current Roadworks",
        "description": "Returns a list of current roadworks for a highway.",
        "parameters": [
          {
            "name": "roadId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RoadId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Roadworks"
                }
              }
            }
          },
          "204": {
            "description": "Not found."
          },
          "400": {
            "description": "Internal server error."
          },
          "404": {
            "description": "Not found."
          }
        }
      }
    },
