# Credentials for hands-on exercise capture
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# SAP BTP admin credentials (used for IAS login)
# Example: ADMINUSER=xp260-001@education.cloud.sap
ADMINUSER=
ADMINPASS=

# IDP hostname as shown on the SAP IAS login page.
# This is the link text the recorder clicks to select your identity provider.
# Example: IAS=tdct3ched1.accounts.ondemand.com
IAS=
